# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://dev:dev@127.0.0.1:5432/people?schema=public"

# --- Session --------------------------------------------------------------
# 32+ char secret used to sign the session cookie.
AUTH_SECRET="change-me-to-a-long-random-string-0123456789"

# --- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Base URL used to build the OAuth redirect URI.
APP_URL="http://localhost:3000"

# --- Access control -------------------------------------------------------
# Comma separated list of Google Workspace domains allowed to sign in.
ALLOWED_GOOGLE_DOMAINS="elliot.ai,lighter.xyz"
# Comma separated emails that are always promoted to ADMIN on login.
ADMIN_EMAILS="christina.zeidan@elliot.ai"

# --- Development login ----------------------------------------------------
# When true, /login exposes an account picker so the app can be used without
# Google credentials. Never enable in production.
DEV_AUTH_ENABLED="true"

# --- Dashboard ------------------------------------------------------------
# Days without a check-in note before someone appears under "Overdue check-ins".
CHECK_IN_THRESHOLD_DAYS="30"
